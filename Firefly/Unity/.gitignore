# Unity .gitignore — must live at the Unity project root, because these
# patterns are anchored with a leading slash.
# Based on github/gitignore Unity.gitignore.

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Autogenerated VS/Rider/Consulo files
.vs/
.vscode/
.idea/
.gradle/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Meta files are only ignored when their asset is also ignored
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Asset Store / JetBrains drop-ins
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# Build artefacts
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Addressables build output
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Never ignore .meta files for assets that ARE tracked — Unity breaks
# without them.
!/[Aa]ssets/**/*.meta
