# Repo-root ignores.
# Unity has its own .gitignore inside Firefly/Unity/ — Unity's standard rules
# are anchored with a leading slash, so they only work from the project root.

# ── OS junk ─────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Editors ─────────────────────────────────────────────
.vs/
.vscode/
.idea/
*.swp
*~

# ── Eclipse workspace state (Firefly Original) ──────────
# IDE state, indexes, logs and temp files — regenerated by Eclipse
# on open. The projects, source and vendored libraries ARE committed;
# only this scratch state is excluded. Delete these lines if you want a
# byte-for-byte snapshot of the workspace folder.
**/.metadata/
**/.metadatamac/
**/RemoteSystemsTempFiles/

# ── C/C++ build output ──────────────────────────────────
[Dd]ebug/
[Rr]elease/
*.o
*.obj
*.d
*.exe
*.hex
*.elf

# ── Arduino build output ────────────────────────────────
build/
*.hex
*.elf

# ── Firefly runtime state ───────────────────────────────
# Remembered serial ports, written beside the executable (and beside
# Assets/ when running in the Editor). Machine-specific.
firefly_ports.txt
